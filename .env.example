# --- Configuracion basica ---
PORT=3000
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
ADMIN_EMAIL=admin@rutasaber.com
ADMIN_PASSWORD=CambiarEsta123!
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Ruta Saber

# --- Base de datos ---
# Para uso LOCAL (en tu computador) no necesitas tocar nada aqui abajo:
# la app crea automaticamente un archivo SQLite en data/rutasaber.db.
#
# Para desplegar en internet gratis (Render.com, cuyo plan gratuito no tiene
# disco persistente), crea una base de datos gratuita en https://turso.tech
# (ver README, seccion de despliegue) y descomenta estas dos variables con
# tus propios valores:
# TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
# TURSO_AUTH_TOKEN=el-token-que-te-da-turso
