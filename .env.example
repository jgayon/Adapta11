# --- Configuracion basica ---
PORT=3000
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
ADMIN_EMAIL=admin@rutasaber.com
ADMIN_PASSWORD=CambiarEsta123!
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Ruta Saber

# URL publica de la app (sin / al final). Se usa para armar el enlace del
# correo de confirmacion de profesor. En local deja el valor de abajo; en
# Render, pon la URL real del servicio (https://adapta11.onrender.com).
APP_URL=http://localhost:3000

# --- Correo de confirmacion de profesor (API de Brevo, no SMTP) ---
# Render bloquea las conexiones SMTP salientes en su plan gratuito (puertos
# 465/587), asi que Gmail por SMTP (nodemailer) se queda colgado hasta dar
# "Connection timeout" sin importar la contraseña. Por eso el correo se manda
# por la API HTTP de Brevo (https://www.brevo.com, plan gratis: 300/dia, sin
# necesitar dominio propio), que viaja por HTTPS y si funciona en Render.
#
# Como configurarlo (una sola vez):
#   1. Crea una cuenta gratis en https://www.brevo.com
#   2. "Senders" -> agrega el correo remitente (puede ser un Gmail normal) ->
#      confirma el correo que te manda Brevo a esa cuenta ("Single Sender
#      Verification", no requiere verificar un dominio).
#   3. "Settings" -> "SMTP & API" -> "API Keys" -> genera una API key.
#
# GMAIL_USER: el correo remitente, el mismo que verificaste en Brevo.
# BREVO_API_KEY: la API key que generaste en el paso 3.
GMAIL_USER=cambia-esto@gmail.com
BREVO_API_KEY=cambia-esto-por-tu-api-key-de-brevo

# --- Base de datos (Roble, Uninorte OpenLab) ---
# La app ya no usa SQLite/Turso: los datos viven en un proyecto de Roble
# (https://roble.test-openlab.uninorte.edu.co). Las 6 tablas se crean una
# sola vez desde la Consola SQL del panel de Roble (ver
# claude/plan-migracion-roble.md); estas variables son las que el backend
# necesita para conectarse a ese proyecto ya creado:
ROBLE_BASE_URL=https://roble-api.test-openlab.uninorte.edu.co
ROBLE_CONTRACT_ID=adapta11_c0f86002c5

# Cuenta de servicio: no es una cuenta de estudiante/profesor, es la cuenta
# de Roble con la que el backend inicia sesion al arrancar para poder leer y
# escribir en las tablas. Se crea una sola vez (POST /auth/{id}/signup +
# verificacion por correo) y en el panel de Roble se le asigna el rol
# "editor" (Autenticacion -> Usuarios de la aplicacion).
ROBLE_SERVICE_EMAIL=cambia-esto@tu-correo.com
ROBLE_SERVICE_PASSWORD=cambia-esta-clave
